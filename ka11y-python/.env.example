# ─── ka11y Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.

# Deepgram API key for WCAG 1.2.1 transcript quality evaluation
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Gemini API key used by enrich_audit.py to generate the dynamic reason and
# suggested fix for each violation. Optional — if unset, enrichment is skipped
# and reports fall back to the static reason/suggested_fix.
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Observability / tracing ───────────────────────────────────────────────
# End-to-end traces of the audit engine — API requests, crawler runs, each page
# processed, each stage and rule, every Gemini call (model, tokens, cost),
# errors and latency throughout — to either Arize AX or a local Phoenix.
# Optional: with all of this unset, tracing stays off and the audit runs
# exactly as before.

# Arize AX credentials (Arize UI → Space Settings → API keys).
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# Project the spans are filed under, in Arize or Phoenix (default: ka11y).
ARIZE_PROJECT_NAME=ka11y
# Arize AX collector override. Normally empty — the SDK defaults to
# otlp.arize.com. This does NOT point at Phoenix; see the block below.
ARIZE_COLLECTOR_ENDPOINT=
# OTLP protocol for whichever backend is in use: grpc (default), http, https.
ARIZE_TRANSPORT=grpc

# Which backend wins:
#   unset / auto  → Arize AX when the credentials above are set, else Phoenix
#                   if an endpoint is configured, else tracing off
#   phoenix       → always the local Phoenix, even with Arize credentials set
#                   (so you can develop locally without deleting them)
#   arize         → always Arize AX
# KA11Y_TRACING_BACKEND=phoenix

# Where the local Phoenix collector listens. Inside Docker Compose this is the
# service name (the compose file already sets http://phoenix:4317); on the host
# — running enrich_audit.py directly — it is localhost.
#   gRPC:  http://localhost:4317
#   HTTP:  http://localhost:6006/v1/traces   (set ARIZE_TRANSPORT=http too)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

# Force tracing on/off regardless of the above. Unset = auto.
# KA11Y_TRACING_ENABLED=1
# Print spans to stdout as well, for debugging the pipeline locally.
# KA11Y_TRACING_CONSOLE=1

# Ceiling on a single span attribute, in characters (default 8192). Span
# payloads can be whole page snapshots; an oversized attribute overruns the
# collector's message limit and drops the entire batch of spans with it, so
# values above this are truncated. Raise it only against a collector you know
# accepts larger messages.
# KA11Y_TRACING_MAX_ATTR_CHARS=8192

# ─── Crawler / browser pool ────────────────────────────────────────────────
# Concurrent browser contexts (one Chromium process). This is the single
# concurrency knob for browser work; KA11Y_MAX_BROWSERS and the retired
# KA11Y_HEAVY_STAGE_CONCURRENCY are accepted as aliases.
# KA11Y_MAX_BROWSER_CONTEXTS=2
# Recycle the pool's Chromium between leases when it exceeds this RSS (MB) or
# age (seconds). 0 / unset = never. Never interrupts a running crawl.
# KA11Y_BROWSER_MAX_MEMORY_MB=0
# KA11Y_BROWSER_MAX_LIFETIME_S=0
# Universal crawl: pages crawled in parallel on one context.
# KA11Y_UNIVERSAL_PARALLEL_PAGES=4
# Image crawl deadline: per discovered page, and the hard ceiling (seconds).
# KA11Y_IMAGE_CRAWL_PER_PAGE_SECONDS=20
# KA11Y_IMAGE_CRAWL_TIMEOUT_CEILING=600
# Dormant per-page extractors (nothing consumes them today; off by default).
# KA11Y_UNIVERSAL_PIPELINE_CONTEXTS=0
# KA11Y_UNIVERSAL_BACKGROUND_IMAGES=0

# ─── Production database (PostgreSQL) ──────────────────────────────────────
# Users, OAuth identities, sessions, audit ownership and history.
# POSTGRES_* configure the compose `postgres` service; DATABASE_URL is what
# the API connects with (host "postgres" inside compose, "localhost" on the
# host, the RDS endpoint + ?sslmode=require in production).
POSTGRES_DB=ka11y
POSTGRES_USER=ka11y
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://ka11y:change-me@postgres:5432/ka11y

# ─── Sign-in (OAuth 2.0 / OpenID Connect; no local passwords) ──────────────
# Google: console.cloud.google.com → APIs & Services → Credentials →
# OAuth client ID (Web application). Authorised redirect URI must be EXACTLY
# KA11Y_OIDC_REDIRECT_URI below (the public UI origin + /api/v1/auth/callback).
KA11Y_OIDC_ISSUER=https://accounts.google.com
KA11Y_OIDC_CLIENT_ID=
KA11Y_OIDC_CLIENT_SECRET=
KA11Y_OIDC_REDIRECT_URI=https://a11y.bluecaffeine.in/api/v1/auth/callback
KA11Y_OIDC_PROVIDER_NAME=google
# Seals the session + OIDC cookies (AES-256-GCM, key derived by HKDF). At
# least 32 characters; rotating it signs everyone out.
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KA11Y_SESSION_SECRET=
# Only these people can sign in (comma-separated, case-insensitive). Leave
# both empty to admit anyone the provider authenticates.
KA11Y_ALLOWED_EMAILS=meghana@bluecaffeine.com,riyanka@bluecaffeine.com,prasanth@bluecaffeine.com,sanjaypranav@bluecaffeine.com,kalanithi@bluecaffeine.com,ashish@bluecaffeine.com,hemalatha@bluecaffeine.com,watanabe.kanae2@kao.com
KA11Y_ALLOWED_EMAIL_DOMAINS=
# Who may open the admin console (/admin) and admin API routes. Must also be
# on the allow-list above. Empty = nobody.
KA11Y_ADMIN_EMAILS=
# E-mail + password sign-in (works alongside or instead of OIDC). Registration
# lets an allow-listed address create its own password; set it to 0 and use
# `poetry run python scripts/set_password.py someone@kao.com` instead.
# KA11Y_PASSWORD_LOGIN=1
# KA11Y_PASSWORD_REGISTRATION=1
# Closed pilot without registration: at start-up every KA11Y_ALLOWED_EMAILS
# address gets an account and, if it has no password yet, this one. Existing
# passwords are never overwritten (change one with scripts/set_password.py).
# KA11Y_BOOTSTRAP_PASSWORD=
# Session idle timeout (hours) / "keep me signed in" (days) / absolute cap (days)
# KA11Y_SESSION_IDLE_HOURS=12
# KA11Y_SESSION_REMEMBER_DAYS=30
# KA11Y_SESSION_MAX_DAYS=30
# Live sessions per user; opening one more ends the least recently used.
# KA11Y_SESSION_MAX_PER_USER=5
#
# ─── Transport ─────────────────────────────────────────────────────────────
# Everything below defaults from KA11Y_OIDC_REDIRECT_URI: an https URI turns
# on Secure + __Host- cookies, HSTS and the http→https 308. Nothing to set
# in production. Local dev over plain http://localhost:8080 needs:
# KA11Y_COOKIE_SECURE=0
# Fine-grained overrides (rarely needed):
# KA11Y_COOKIE_HOST_PREFIX=1    __Host-ka11y_session instead of ka11y_session
# KA11Y_FORCE_HTTPS=1           308 any plain-http request (loopback exempt)
# KA11Y_HSTS_MAX_AGE=31536000   0 disables the HSTS header
# KA11Y_HSTS_PRELOAD=0          1 adds includeSubDomains; preload
#
# Request brakes (per client IP, per minute) and body cap (bytes):
# KA11Y_RATE_LIMIT_POST=30
# KA11Y_RATE_LIMIT_AUTH=20
# KA11Y_MAX_BODY_BYTES=2097152
#
# PostgreSQL TLS: any non-local DATABASE_URL host gets sslmode=require unless
# the URL already says otherwise. Pin the CA for the strongest setting:
# KA11Y_DB_SSLMODE=verify-full
# KA11Y_DB_SSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem
# Tests / local hacking only — every protected route runs anonymously:
# KA11Y_AUTH_DISABLED=1

# ─── Artifact storage (S3) ─────────────────────────────────────────────────
# Screenshots, element/OCR crops, HTML snapshots, OCR reports, step logs and
# the JSON/CSV/PDF reports of every audit. Unset KA11Y_S3_BUCKET and they are
# kept under KA11Y_ARTIFACT_DIR on disk instead (same key layout).
# Key layout: organizations/{org}/users/{user}/sessions/{session}/jobs/{job}/
#             {reports|assets|raw|crash}/…   (UUIDs only, never emails)
KA11Y_S3_BUCKET=
KA11Y_S3_PREFIX=wcag-auditor
KA11Y_S3_REGION=ap-northeast-1
# Credentials: standard AWS chain. On EC2/ECS prefer an instance/task role and
# leave these empty; otherwise a least-privilege key with s3:PutObject,
# s3:GetObject, s3:DeleteObject, s3:ListBucket on the bucket/prefix above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Server-side encryption header (AES256 or aws:kms + KA11Y_S3_KMS_KEY_ID).
# Leave empty to rely on the bucket's default encryption.
KA11Y_S3_SSE=
# MinIO / LocalStack for local development:
# KA11Y_S3_ENDPOINT_URL=http://localhost:9000
# Presigned download link lifetime in seconds (default 900).
# KA11Y_S3_PRESIGN_SECONDS=900
# Render + upload report.pdf on completion (Chromium; ~seconds per audit).
# KA11Y_ARTIFACT_PDF=1
# Save each crawled page's rendered HTML as an asset.
# KA11Y_HTML_SNAPSHOTS=1
# Delete a job's objects when the 30-day retention sweep removes the run.
# Default 0: keep them and let an S3 lifecycle rule expire/transition them.
# KA11Y_ARTIFACT_DELETE_ON_RETENTION=0
