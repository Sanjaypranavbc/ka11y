# ─── ka11y Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.

# Deepgram API key for WCAG 1.2.1 transcript quality evaluation
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Gemini API key used by enrich_audit.py to generate the dynamic reason and
# suggested fix for each violation. Optional — if unset, enrichment is skipped
# and reports fall back to the static reason/suggested_fix.
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Observability / tracing ───────────────────────────────────────────────
# Traces every Gemini enrichment call — model, input, tokens, latency, errors —
# to either Arize AX or a local Phoenix. Optional: with all of this unset,
# tracing stays off and the audit runs exactly as before.

# Arize AX credentials (Arize UI → Space Settings → API keys).
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# Project the spans are filed under, in Arize or Phoenix (default: ka11y).
ARIZE_PROJECT_NAME=ka11y
# Arize AX collector override. Normally empty — the SDK defaults to
# otlp.arize.com. This does NOT point at Phoenix; see the block below.
ARIZE_COLLECTOR_ENDPOINT=
# OTLP protocol for whichever backend is in use: grpc (default), http, https.
ARIZE_TRANSPORT=grpc

# Which backend wins:
#   unset / auto  → Arize AX when the credentials above are set, else Phoenix
#                   if an endpoint is configured, else tracing off
#   phoenix       → always the local Phoenix, even with Arize credentials set
#                   (so you can develop locally without deleting them)
#   arize         → always Arize AX
# KA11Y_TRACING_BACKEND=phoenix

# Where the local Phoenix collector listens. Inside Docker Compose this is the
# service name (the compose file already sets http://phoenix:4317); on the host
# — running enrich_audit.py directly — it is localhost.
#   gRPC:  http://localhost:4317
#   HTTP:  http://localhost:6006/v1/traces   (set ARIZE_TRANSPORT=http too)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

# Force tracing on/off regardless of the above. Unset = auto.
# KA11Y_TRACING_ENABLED=1
# Print spans to stdout as well, for debugging the pipeline locally.
# KA11Y_TRACING_CONSOLE=1
