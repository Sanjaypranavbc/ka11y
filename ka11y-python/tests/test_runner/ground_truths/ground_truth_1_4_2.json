      "description": "Audio plays > 3s with native controls (Pass)",
      "dom_attributes": {
        "tag_name": "audio",
        "autoplay": true,
        "controls": true
      },
      "context": {
        "duration": 10.0
      },
      "expected": {
        "status": "pass",
        "reason_code": "has_native_controls"
      }
    },
    {
