        "muted": false
      },
      "context": {
        "duration": 5.0
      },
      "expected": {
        "status": "fail",
        "reason_code": "no_controls"
      }
    },
    {
      "id": "c142-05",
      "description": "Muted video > 3s with no controls (Pass)",
      "dom_attributes": {
        "tag_name": "video",
        "autoplay": true,
        "controls": false,
        "muted": true
      },
      "context": {
        "duration": 5.0
      },
      "expected": {
        "status": "pass",
        "reason_code": "muted_media"
      }
