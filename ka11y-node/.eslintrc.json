{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:node/recommended",
    "plugin:security/recommended"
  ],
  "plugins": [
    "jsx-a11y",
    "security"
  ],
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "node/no-unsupported-features/es-syntax": "off",
    "no-process-exit": "off",
    "security/detect-object-injection": "off"
  }
}
