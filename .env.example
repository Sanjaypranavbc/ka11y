# =============================================================================
# ka11y — environment configuration
# Copy to .env and edit values. docker-compose reads .env automatically.
# =============================================================================

# ── Public URLs ──────────────────────────────────────────────────────────────
# Origin where the browser reaches the Python API. Baked into the frontend
# JS bundle at build time, so a rebuild is needed if this changes.
#   - Local dev:        http://localhost:8000
#   - EC2 public IP:    http://<ec2-public-ip>:8000
#   - Behind a domain:  https://api.example.com
VITE_API_URL=http://localhost:8000

# ── Auth (Python service) ────────────────────────────────────────────────────
# Comma-separated list of accepted X-API-Key values. If empty, the API runs
# in soft mode (open to anyone, IP-rate-limited). Keep this secret.
# Generate a key with:  openssl rand -hex 32
KA11Y_API_KEYS=

# ── Python service build args ────────────────────────────────────────────────
# Set INSTALL_JAPANESE=0 to skip sudachipy/sudachidict + ja_core_news_lg
# (~500MB smaller image; EN-only).
INSTALL_JAPANESE=1

# faster-whisper model size (base | tiny | small | medium | large-v3).
# tiny is ~75MB, base is ~150MB, larger sizes blow up the image.
WHISPER_MODEL_SIZE=base

# ── Host port bindings ───────────────────────────────────────────────────────
# Override only if the defaults clash with something else on the host.
FRONTEND_HOST_PORT=8080
PYTHON_HOST_PORT=8000
NODE_HOST_PORT=3000
DOCS_HOST_PORT=3001
